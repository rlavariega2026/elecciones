Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /elecciones/
RewriteRule ^api(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
</IfModule>
<FilesMatch "^(\.env|database\.json|.*\.bak)$">
Require all denied
</FilesMatch>
